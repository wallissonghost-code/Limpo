{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "limpo",
  "main": "src/worker-entry.js",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LOGIN_LIMITER",
        "class_name": "LoginLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LoginLimiter"]
    }
  ]
}
